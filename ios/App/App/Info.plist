<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SN AXIS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>SN AXIS connects to your AXIS accessories (knob, gauge and CAN monitor) over Bluetooth to configure them and show live driving data.</string>
	<!-- iOS 12 fallback. NSBluetoothAlwaysUsageDescription only
	     applies on iOS 13+; on iOS 12 the system reads the
	     Peripheral key instead. Same wording for both so user
	     experience is consistent regardless of OS version. -->
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>SN AXIS connects to your AXIS accessories (knob, gauge and CAN monitor) over Bluetooth to configure them and show live driving data.</string>
	<!-- App Store export-compliance declaration. SN AXIS uses
	     only OS-provided crypto (BLE Secure Connections, HTTPS) — no
	     proprietary or non-standard encryption — which qualifies for
	     the standard exemption. Setting this key removes the manual
	     "Did you use any encryption?" prompt on every TestFlight /
	     App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SN AXIS uses your location on the Track screen to time your laps and record your route. Your location stays on your device and is never uploaded.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SN AXIS connects to your AXIS knob over its Wi-Fi network to update firmware, customize settings, and stream telemetry.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- The UI is a single fixed-portrait phone layout, so the app is
	     iPhone-only (TARGETED_DEVICE_FAMILY=1) and portrait-locked. This
	     removes the "looks broken in landscape / on iPad" failure mode that
	     a fixed layout otherwise produces on unsupported orientations. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Keep the BLE connection alive when the app is briefly backgrounded (e.g.
	     the user swipes away mid firmware-update). Without this, iOS tears the
	     Central connection down on background and the OTA transfer dies. NOTE:
	     iOS still SUSPENDS JS execution when backgrounded, so a webview-driven OTA
	     can only RESUME on return — this preserves the link so it can. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
</dict>
</plist>
